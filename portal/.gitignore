node_modules
dist
dist-ssr
*.local
.env
.env.local
# The real e2e config. Its one secret is now E2E_STORAGE_STATE — the path to a minted
# session's cookies; there is no QA password, because sign-in is Azure SSO only, and the
# Foundry key and JWT_SECRET are the backend's, not this package's. Only the template
# .env.e2e.example is committed.
.env.e2e
.DS_Store

# Playwright e2e — auth state holds JWTs; traces/videos capture JWTs + response
# bodies. Never commit; scrub before any future CI artifact upload.
playwright/.auth/
test-results/
playwright-report/

# tsc --build incremental cache — a local artifact, never a shipped one.
*.tsbuildinfo

# Python tool artifacts from the Docker-backed router harness under tests/. That suite runs
# under the BACKEND interpreter (`uv run --project ../backend pytest`), so it drops the same
# caches backend/ and sandbox/ already ignore — this keeps them out of a Node project's tree.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# uv artifacts. `pyproject.toml` here carries pytest/ruff config only and has no [project]
# table, which uv reads as an implicit VIRTUAL WORKSPACE ROOT (astral-sh/uv#4541) — so any bare
# `uv` call in portal/ (i.e. one that forgets `--project ../backend`) drops a .venv and an empty
# 3-line uv.lock into this Node package. There are no Python deps to lock at this level; the
# harness resolves against backend/uv.lock.
uv.lock
.venv/
