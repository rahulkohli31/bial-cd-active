# ── portal e2e (Playwright) — the control-plane is FastAPI ──────────────────
# Copy to .env.e2e (GITIGNORED). These are the only two variables the setup reads;
# everything else it needs is exported per run (E2E_BASE_URL, E2E_REAL_SANDBOX, …).
#
# There is NO password to put here: sign-in is Azure SSO, so a browser cannot log in
# without a live tenant. A real-session run is seeded from a file instead — see
# e2e/auth.setup.ts for the two modes and what each one actually proves.

# The QA identity the mocked fallback renders as. Required in BOTH modes: the setup
# refuses to start without it rather than inventing an anonymous profile.
E2E_QA_EMAIL=<qa-user-email>

# A Playwright storage-state JSON — { "cookies": [ … ] } — holding a real control-plane
# session for that user. Set it and every spec drives the real backend; leave it out and
# only /auth/me is mocked, so any spec touching real data is exercising an empty shell.
# It is a credential: keep it outside this repo. The script that mints one lives in the
# local-only governance tree and is not distributed here.
E2E_STORAGE_STATE=<path to that file>
