# BIAL backend configuration template. Copy to `.env` (dev) and `.env.test`
# (tests) and fill in real values. NEVER commit a filled-in .env — only this
# template. Required settings have NO default: a missing one fails at startup.

# --- Core (required) ---------------------------------------------------------
# Closed set: development | staging | production
ENVIRONMENT=development
# Async SQLAlchemy URL (asyncpg driver). Local dev points at the compose Postgres.
DATABASE_URL=postgresql+asyncpg://bial:bial@localhost:5544/citizen_one

# How DATABASE_URL authenticates. Unset -> "password" (the password embedded in the
# DSN above; local Docker Postgres + tests). For PRODUCTION on Azure Database for
# PostgreSQL Flexible Server with Microsoft Entra, switch to managed-identity token
# auth: no static password, no ?ssl= (TLS verify-full is enforced in code), and the
# DSN user is the managed identity's NAME (no @servername suffix on Flexible Server).
# DB_AUTH_MODE=entra
# DB_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000   # user-assigned MI client id; omit for system-assigned
# DATABASE_URL=postgresql+asyncpg://<managed-identity-name>@bial-genai-adbps-01.postgres.database.azure.com:5432/citizen_one

# Super-admin RBAC allowlist (R7) — comma-separated Entra emails, matched
# case-insensitively per request. Required, no default: a missing value — or one
# that normalizes to an EMPTY list — fails at startup in every environment (a
# control-plane with no configured admins is a misconfiguration). The role is
# COMPUTED from this list — there is no mutable DB role column.
SUPERADMIN_EMAILS=admin@bial.example,superadmin@bial.example

# --- Core (optional knobs) ---------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Global per-user daily token cap (R13/R30) — the effective limit for a user with no
# per-user override. Optional knob with a defined default (1,000,000 = the standard
# plan, mirroring Express DEFAULT_DAILY_TOKEN_LIMIT). Must be a positive integer.
# DAILY_TOKEN_LIMIT=1000000

# Gotenberg sidecar base URL for pptx→PDF deck conversion (U11). Optional: unset
# means deck conversion is DISABLED (deck uploads are rejected).
# GOTENBERG_URL=http://localhost:3000

# --- Object storage (U6; optional in dev/test, required in production) --------
# Azure Blob Storage only. Nested keys use the __ delimiter; set EXACTLY ONE auth
# mode (connection_string with an embedded AccountKey, account_key, or managed
# identity). The Azurite example account_url below matches docker-compose.test.yml.
# OBJECT_STORE__PROVIDER=azure
# OBJECT_STORE__ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
# OBJECT_STORE__CONTAINER=bial
# OBJECT_STORE__CONNECTION_STRING=...            # or ACCOUNT_KEY, or USE_MANAGED_IDENTITY=true

# --- Redis coordination (optional in dev/test, required in production) -------
# Coordinates the one-sandbox-per-user lock, the idle heartbeat, and the sandbox
# registry. Unset -> the API still boots, but every build-session call raises
# RedisNotConfiguredError, so local development of the BUILD path needs this line.
# Local value below is the Homebrew/Docker default (plaintext, no auth).
REDIS__URL=redis://localhost:6379/0
# PRODUCTION must use the TLS scheme on port 6380 — a plaintext redis:// URL is
# REFUSED at startup (it would put the coordination keys and any DSN-embedded
# password on the wire). Azure Cache for Redis:
# REDIS__URL=rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0
#
# --- Redis (optional knobs; defaults shown) ----------------------------------
# Every REDIS__* key must map to a declared RedisConfig field — the block is
# extra="forbid", so a typo'd knob fails at STARTUP rather than silently defaulting.
# REDIS__MAX_CONNECTIONS=10
# REDIS__SOCKET_TIMEOUT_SECONDS=2.0          # reply wait on an open socket
# REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=2.0  # opening the socket
# Retry policy. `from_url` clients get ZERO retries from redis-py, so the pool
# factory always passes an explicit Retry built from these. Total attempts =
# RETRY_ATTEMPTS + 1; 0 is a valid escape hatch (fail on the first error).
# Worst case with the defaults: ~8.7s against a dead host, ~16.7s against a hung one.
# REDIS__RETRY_ATTEMPTS=3
# REDIS__RETRY_BACKOFF_BASE_SECONDS=0.05
# REDIS__RETRY_BACKOFF_CAP_SECONDS=0.5

# --- Entra ID auth (required — ADR-0007) -------------------------------------
# Backend-owned OpenID Connect (Authorization Code + PKCE). The AUTH__* block is a
# required sub-model: a missing value fails at startup in EVERY environment. Nested
# keys use the __ delimiter. tenant_id pins the single tenant (outside-tenant sign-ins
# are rejected). redirect_uri is used VERBATIM as the OAuth callback and MUST byte-match
# the reply URL registered in the Entra app (including any external /api prefix, KD-8).
AUTH__TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH__CLIENT_ID=00000000-0000-0000-0000-000000000000
# OPTIONAL while the Entra app registration is a PUBLIC client — the backend presents no secret
# at the token endpoint (public-client hotfix; AADSTS700025). Required again once the app is
# switched back to a confidential client.
AUTH__CLIENT_SECRET=change-me-entra-app-client-secret
# >= 32 chars: signs the session JWT + CSRF token and seeds SessionMiddleware.
AUTH__SESSION_SECRET=change-me-generate-a-long-random-secret-32chars-min
AUTH__REDIRECT_URI=https://your-host/api/v1/auth/callback
# A1: the SECOND reply URL, for the sandbox login broker (generated-app login gate). Register
# this as an additional redirect URI on the SAME Entra app registration, on the SAME host as
# AUTH__REDIRECT_URI (no separate app registration, no separate host).
AUTH__SANDBOX_REDIRECT_URI=https://your-host/api/v1/auth/sandbox/callback
# --- Entra ID auth (optional knobs; defaults shown) --------------------------
# AUTH__ACCESS_TTL_SECONDS=900           # session JWT lifetime
# AUTH__REFRESH_TTL_SECONDS=604800       # per-refresh-token lifetime
# AUTH__ABSOLUTE_SESSION_SECONDS=28800   # family hard cap (~8h) — re-auth after
# AUTH__SESSION_COOKIE_MAX_AGE=600       # oauth transient-state cookie lifetime
# AUTH__COOKIE_SECURE=                    # unset -> derive from ENVIRONMENT.
#                                         # `false` is legitimate in dev/staging (plain http)
#                                         # but REFUSES TO BOOT in production: it would drop
#                                         # Secure + the __Host-/__Secure- cookie prefixes.

# --- Azure AI Foundry (Claude) — optional until the chat endpoint lands (U13) --
# The ONLY sanctioned path to the model (R11/AE5 — never the public Anthropic API).
# Nested FOUNDRY__* keys. Set exactly one auth mode: a static API key
# (AUTH_MODE=api_key + API_KEY) or a managed-identity token provider (AUTH_MODE=entra).
# Unset entirely -> AI chat not configured.
# FOUNDRY__RESOURCE=your-foundry-resource-name
# FOUNDRY__DEPLOYMENT=your-claude-deployment-name
# FOUNDRY__AUTH_MODE=api_key             # or: entra (managed identity, no static key)
# FOUNDRY__API_KEY=change-me-foundry-api-key

# --- Per-project app databases (ADR-0028; optional in dev/test, REQUIRED in prod) --
# Each project gets its own PostgreSQL database + scoped LOGIN role; the platform owns
# their lifecycle and the generated app (Drizzle) owns everything inside. Unset -> the
# control plane boots and projects simply get no database (the provisioner no-ops).
#
# MAINTENANCE_DSN is a DEDICATED role — CREATEDB + CREATEROLE, NOT the control-plane
# DATABASE_URL identity — pointed at a NEUTRAL maintenance database (`postgres`), never
# citizen_one. It drives its own AUTOCOMMIT engine (CREATE DATABASE cannot run inside a
# transaction). On Azure Flexible Server append `?ssl=require` exactly as DATABASE_URL does.
#   CREATE ROLE bial_appdb_maint LOGIN CREATEDB CREATEROLE NOSUPERUSER PASSWORD '...';
# APP_DB__MAINTENANCE_DSN=postgresql+asyncpg://bial_appdb_maint:change-me@localhost:5544/postgres
#
# ENCRYPTION_KEY encrypts each app role's password at rest (Fernet). Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Its blast radius is fleet-wide — rotating it means re-encrypting project_databases.
# APP_DB__ENCRYPTION_KEY=change-me-urlsafe-base64-32-byte-fernet-key
#
# --- Per-project databases (optional knobs; defaults shown) -------------------
# host:port the SANDBOX CONTAINER can reach the database server on — the host baked into the
# injected BIAL_DATABASE_URL. Unset = reuse the maintenance DSN's own host, correct whenever
# control plane and sandbox share an address (real Azure). Local dev needs an override:
# leaving it unset hands the container the control plane's `localhost`, which inside the
# container is the CONTAINER's own localhost and never connects — the same trap
# SANDBOX__BLOB_BASE_URL exists to solve, in its database form.
# APP_DB__SANDBOX_DSN_HOST=host.docker.internal:5432
# Applied per role, per database with ALTER ROLE ... IN DATABASE ... SET.
# APP_DB__STATEMENT_TIMEOUT_MS=30000
# APP_DB__IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
