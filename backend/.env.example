# BIAL backend configuration template. Copy to `.env` (dev) and `.env.test`
# (tests) and fill in real values. NEVER commit a filled-in .env — only this
# template. Required settings have NO default: a missing one fails at startup.

# --- Core (required) ---------------------------------------------------------
# Closed set: development | staging | production
ENVIRONMENT=development
# Async SQLAlchemy URL (asyncpg driver). Local dev points at the compose Postgres.
DATABASE_URL=postgresql+asyncpg://bial:bial@localhost:5544/citizen_one

# --- Core (optional knobs) ---------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Object storage (U6; optional in dev/test, required in production) --------
# Azure Blob Storage only. Nested keys use the __ delimiter; set EXACTLY ONE auth
# mode (connection_string with an embedded AccountKey, account_key, or managed
# identity). The Azurite example account_url below matches docker-compose.test.yml.
# OBJECT_STORE__PROVIDER=azure
# OBJECT_STORE__ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
# OBJECT_STORE__CONTAINER=bial
# OBJECT_STORE__CONNECTION_STRING=...            # or ACCOUNT_KEY, or USE_MANAGED_IDENTITY=true

# --- Entra ID auth (required — ADR-0007) -------------------------------------
# Backend-owned OpenID Connect (Authorization Code + PKCE). The AUTH__* block is a
# required sub-model: a missing value fails at startup in EVERY environment. Nested
# keys use the __ delimiter. tenant_id pins the single tenant (outside-tenant sign-ins
# are rejected). redirect_uri is used VERBATIM as the OAuth callback and MUST byte-match
# the reply URL registered in the Entra app (including any external /api prefix, KD-8).
AUTH__TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH__CLIENT_ID=00000000-0000-0000-0000-000000000000
AUTH__CLIENT_SECRET=change-me-entra-app-client-secret
# >= 32 chars: signs the session JWT + CSRF token and seeds SessionMiddleware.
AUTH__SESSION_SECRET=change-me-generate-a-long-random-secret-32chars-min
AUTH__REDIRECT_URI=https://your-host/api/v1/auth/callback
# --- Entra ID auth (optional knobs; defaults shown) --------------------------
# AUTH__ACCESS_TTL_SECONDS=900           # session JWT lifetime
# AUTH__REFRESH_TTL_SECONDS=604800       # per-refresh-token lifetime
# AUTH__ABSOLUTE_SESSION_SECONDS=28800   # family hard cap (~8h) — re-auth after
# AUTH__SESSION_COOKIE_MAX_AGE=600       # oauth transient-state cookie lifetime
# AUTH__COOKIE_SECURE=                    # unset -> derive from ENVIRONMENT
