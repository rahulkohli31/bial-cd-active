# Test configuration template. Copy to `.env.test`. The database name MUST
# contain "test" — the test harness refuses to run against a non-test database
# (guard against a missing .env.test silently hitting the dev DB).
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bial:bial@localhost:5544/citizen_one_test
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Super-admin RBAC allowlist — dummy values (tests override via dependency/monkeypatch).
SUPERADMIN_EMAILS=admin@bial.com,superadmin@bial.com

# Redis coordination — DELIBERATELY LEFT UNSET for the test suite. The unset path
# IS the behaviour under test (`tests/test_lifespan.py` asserts `settings.redis is
# None`: startup must open no pool), and the suite builds pools WITHOUT connecting
# (redis.asyncio connects lazily), so no live server is needed. Uncomment only to
# exercise coordination against a real local Redis — expect the lifespan test that
# pins the no-pool startup to fail while it is set. ENVIRONMENT is development
# here, so the production rediss:// gate does not apply to this value.
# REDIS__URL=redis://localhost:6379/0

# Entra ID auth is a required sub-model, so tests need a structurally valid AUTH__*
# block even though Entra is mocked at the Authlib boundary (KD-9) — dummy values are
# fine here (no live tenant round-trip in CI).
AUTH__TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH__CLIENT_ID=00000000-0000-0000-0000-000000000001
AUTH__CLIENT_SECRET=test-client-secret
AUTH__SESSION_SECRET=test-session-secret-0123456789abcdef0123456789
AUTH__REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Dedicated asymmetric key pair for generated-app identity assertions (issue #92,
# R3-R6) — a SEPARATE required sub-model from AUTH__*, never sharing its secret
# (R4). Dummy test key is fine (no live verifier reads it in the default lane).
# Generate a fresh one with the command in AppAssertionConfig's docstring
# (services/auth/config.py).
APP_ASSERTION__PRIVATE_KEY_PEM_

# --- Per-project app databases (ADR-0028) ------------------------------------
# REQUIRED for the provisioning tests, which create and drop REAL databases and
# roles in the default pytest lane. Point MAINTENANCE_DSN at a NEUTRAL maintenance
# database (`postgres`) using a DEDICATED role — never the control-plane identity
# and never citizen_one_test. Create it once:
#   CREATE ROLE bial_appdb_maint LOGIN CREATEDB CREATEROLE NOSUPERUSER
#     PASSWORD 'bial_appdb_maint';
# ENCRYPTION_KEY is a urlsafe-base64 32-byte Fernet key; generate a throwaway with
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_DB__MAINTENANCE_DSN=postgresql+asyncpg://bial_appdb_maint:bial_appdb_maint@localhost:5544/postgres
APP_DB__ENCRYPTION_KEY=vUyTqqnS-nV88uUFUarWk23afW9lVXd-uw3M1WcrBPE=
# Optional knobs (defaults shown). SANDBOX_DSN_HOST overrides only the host:port the
# generated app is handed, for when the sandbox cannot reach the control plane's own
# address (the SANDBOX__BLOB_BASE_URL problem); unset = reuse the DSN's host.
# APP_DB__SANDBOX_DSN_HOST=
# APP_DB__STATEMENT_TIMEOUT_MS=30000
# APP_DB__IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
