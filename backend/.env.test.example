# Test configuration template. Copy to `.env.test`. The database name MUST
# contain "test" — the test harness refuses to run against a non-test database
# (guard against a missing .env.test silently hitting the dev DB).
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bial:bial@localhost:5544/citizen_one_test
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Super-admin RBAC allowlist — dummy values (tests override via dependency/monkeypatch).
SUPERADMIN_EMAILS=admin@bial.com,superadmin@bial.com

# Redis coordination — DELIBERATELY LEFT UNSET for the test suite. The unset path
# IS the behaviour under test (`tests/test_lifespan.py` asserts `settings.redis is
# None`: startup must open no pool), and the suite builds pools WITHOUT connecting
# (redis.asyncio connects lazily), so no live server is needed. Uncomment only to
# exercise coordination against a real local Redis — expect the lifespan test that
# pins the no-pool startup to fail while it is set. ENVIRONMENT is development
# here, so the production rediss:// gate does not apply to this value.
# REDIS__URL=redis://localhost:6379/0

# Entra ID auth is a required sub-model, so tests need a structurally valid AUTH__*
# block even though Entra is mocked at the Authlib boundary (KD-9) — dummy values are
# fine here (no live tenant round-trip in CI).
AUTH__TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH__CLIENT_ID=00000000-0000-0000-0000-000000000001
AUTH__CLIENT_SECRET=test-client-secret
AUTH__SESSION_SECRET=test-session-secret-0123456789abcdef0123456789
AUTH__REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
