# The Taskiq worker's environment. Copy to `backend/.env.worker`, replace every REPLACE_ME, and
# start the process with BOTH of these set — they are read from the real environment, not from
# this file, so they cannot be lines in it:
#
#   BIAL_ROLE=worker          picks the WorkerSettings profile (src/config.py::build_profile)
#   ENV_FILE=.env.worker      picks this file (src/settings/core.py::SETTINGS_CONFIG)
#
# WHY THIS FILE IS TRACKED AND `.env.worker` IS NOT. `backend/.gitignore` is `.env.*` with
# `!.env*.example`, so the real file never leaves your machine and this template always ships.
# Until it existed there was nothing in the repo that said what a worker needs, and that absence
# produced two failures — a worker whose reclamation flag was never set (see
# SANDBOX__RECLAIM_ENABLED below) and one still pointed at a subscription retired two rotations
# ago, reporting `scanned: 0` about a fleet that was not ours.
#
# EVERY VALUE HERE IS AN OBVIOUSLY-FAKE PLACEHOLDER, AND THAT IS LOAD-BEARING. This repository is
# PUBLIC and has no secret scanning. `SandboxConfig` is a REQUIRED block for this role — it
# carries an ACR password — so the temptation to paste a working value in "just to make it parse"
# is real and there is nothing downstream that would catch it.
# `tests/workers/test_reclamation_report_only.py` asserts the shape of every SANDBOX__ value here.
#
# WHAT THE WORKER DELIBERATELY DOES NOT NEED: no AUTH__ (no request to authenticate), no
# SUPERADMIN_EMAILS, no FRONTEND_URL, no FOUNDRY__ (it runs no model), no APP_DB__. The profile
# sets `extra="forbid"`, so adding any of them here does not merely go unused — it stops the
# worker from booting. See `src/settings/worker.py`.

# --- core (every process) -----------------------------------------------------------
# `development` keeps the production gates off, which is the right posture for a local worker.
# In a real deployment set `production` — and then REDIS__URL must use the `rediss://` TLS
# scheme or the profile refuses to construct.
ENVIRONMENT=development
# The PRODUCT database — the same one the API uses. Reclamation reads it to ask "does an app row
# match this container", and writes the `worker_passes` row that is the only evidence a pass ran.
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME
# The single public hostname every generated app is served from. No trailing slash, no path.
APPS_BASE_URL=https://REPLACE-ME.example.com

# --- object store (REQUIRED for this role, not merely production-gated) --------------
# THE SINGLE MISCONFIGURATION THAT COULD DELETE THE FLEET. An unconfigured store makes the
# durable-copy precondition report "CONFIRMED absent" for every container, which a destroy path
# reads as "nothing to preserve". Required in every environment for exactly that reason.
OBJECT_STORE__ACCOUNT_URL=https://REPLACE_ME.blob.core.windows.net
OBJECT_STORE__CONTAINER=REPLACE_ME
# Exactly ONE auth mode. Account key here; comment it out and set
# OBJECT_STORE__USE_MANAGED_IDENTITY=true instead to use the container's managed identity.
OBJECT_STORE__ACCOUNT_KEY=REPLACE_ME

# --- coordination (REQUIRED) ---------------------------------------------------------
# Both the task broker and the spare-list. Without it the worker consumes nothing and can prove
# nothing about ownership — a process that looks healthy, does no work, and whose only symptom is
# the Azure bill. `rediss://` is mandatory when ENVIRONMENT=production.
REDIS__URL=redis://REPLACE_ME:6379/0

# --- ARM access: THE FLEET THIS WORKER JUDGES (REQUIRED) -----------------------------
# READ THESE FOUR AGAINST THE SUBSCRIPTION YOU ACTUALLY MEAN. They decide which containers the
# pass enumerates, and a wrong value here is not an error — it is a clean-looking report about
# somebody else's fleet. The pass now logs the resource group, the managed environment and the
# subscription at `sandbox_reclamation_fleet` on every tick so the divergence is greppable, and
# the admin reclamation report echoes the first two back in `lastPassDetail`.
SANDBOX__SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
SANDBOX__RESOURCE_GROUP=REPLACE_ME
SANDBOX__REGION=REPLACE_ME
SANDBOX__MANAGED_ENVIRONMENT_NAME=REPLACE_ME
# The pre-baked sandbox image, e.g. <registry>.azurecr.io/citizen-dev-sandbox:latest.
SANDBOX__IMAGE_REF=REPLACE_ME
# ACR pull credentials for that image. ACA cannot pull from a private registry without them.
SANDBOX__ACR_SERVER=REPLACE_ME
SANDBOX__ACR_USERNAME=REPLACE_ME
SANDBOX__ACR_PASSWORD=REPLACE_ME

# --- reclamation: TWO FLAGS, AND THIS IS THE FILE THEY BELONG IN ---------------------
# THE FAILURE IN ONE LINE. Setting SANDBOX__RECLAIM_ENABLED in `backend/.env` turns it on for the
# API — which is the process that ANSWERS the admin report — and not for the worker, which is the
# process that RUNS the pass. The worker then declines every tick with `reason=flag_off` while
# the report reads green. `.env` is the file everyone edits; this is the file the pass reads.
#
# `reclaim_enabled` turns the pass ON: it enumerates, classifies and reports what it would do.
SANDBOX__RECLAIM_ENABLED=false
# `reclaim_destroy` is what lets it ACT. Leave it false until a human has read a candidate list
# from POST /v1/admin/apps/reclamation-report and agreed with it — that state existing at all is
# the entire argument for there being two flags rather than one.
SANDBOX__RECLAIM_DESTROY=false

# --- conversation retention: ONE FLAG, AND IT IS REQUIRED ----------------------------
# REQUIRED, with no default: this process is the one that deletes citizens' conversations, and a
# deployment that has not decided whether it does that must refuse to boot rather than have an
# answer picked for it.
#
# THE FIRST ENABLED PASS IS NOT A WEEKLY INCREMENT. Nothing has ever deleted a conversation here,
# so the first run's candidate set is the whole historical backlog — every conversation of every
# kind whose newest message predates the window, Plan and Build chats included, some of which
# have existed since launch. Read that sentence before flipping this.
CONVERSATION_RETENTION_ENABLED=false
# How long a conversation may sit untouched before it is condemned.
CONVERSATION_RETENTION_DAYS=7
# How many conversations one pass may remove. The pass is one transaction, so the ceiling is what
# lets a first run over the backlog commit at all rather than rolling back on every deploy drain;
# what it leaves behind is counted on the pass record and taken by the next run.
CONVERSATION_RETENTION_PER_PASS=500
