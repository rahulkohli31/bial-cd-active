# BIAL runtime env manifest (C6 / C9). SESSION-API injects these — and ONLY these — into the
# sandbox at provision, and re-injects them on snapshot restore. These are NAMES only: real values
# live in process env, never in a committed file.
#
# How the names reach `next dev`: the supervisor's child-env scrub is a fail-closed ALLOWLIST, not
# a suffix denylist. Each name is admitted by being listed EXPLICITLY in the supervisor's
# `_BIAL_INJECTED_KEYS` tuple (C1) — NOT by virtue of its suffix. Adding a BIAL_* var means adding
# it to that allowlist, or the child never sees it (fail closed). All are SERVER-ONLY — read via
# `process.env` in server context, never exposed to the browser (never NEXT_PUBLIC_*).

# app_registry.id — the appId. Goes into the URL path .../apps/<BIAL_APP_ID>/records
BIAL_APP_ID=

# The app's app_key: "bial_" + token_urlsafe(24). Sent as the  X-App-Key: <value>  header.
# This is a publishable, app_id-scoped key (Stripe-publishable-key model), NOT a general
# secret — its blast radius is bounded to this one app's data_records (C9 §5).
BIAL_APP_CREDENTIAL=

# The platform data-service base URL — MUST already include the /v1 prefix, because the data
# module concatenates raw:  BIAL_DATA_BASE_URL + '/apps/' + BIAL_APP_ID + '/records'
# e.g. https://<platform-host>/v1   (no trailing slash)
BIAL_DATA_BASE_URL=

# The portal origin allowed to frame this app (C8) — used as the postMessage targetOrigin by
# the error-capture shim and as Caddy's frame-ancestors value. scheme://host[:port], no path.
# e.g. https://low-code-no-code-platform.azurewebsites.net
BIAL_PORTAL_ORIGIN=

# --- per-app Blob object storage (C9 §6) --------------------------------------------------------
# The app's OWN per-app Blob container: URL + a container-scoped SAS. Read SERVER-SIDE ONLY, and
# accessed directly from the app's own server (never the browser). The container URL is a host the
# sandbox can reach ({sandbox-facing base}/app-<app_id>). NON-secret — safe to log.
BIAL_BLOB_CONTAINER_URL=

# The container-scoped SAS query string (?sv=…&sig=…) the app appends to the container URL. SECRET
# and SERVER-ONLY: never print it, never log it, never persist it to disk, and never send it to the
# browser (not NEXT_PUBLIC_*). It is a bearer capability (read+write+list+delete on this one app's
# container) — the supervisor redacts it from /exec, /dev/logs, and /files output.
BIAL_BLOB_SAS=
