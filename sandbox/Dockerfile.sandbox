# BIAL sandbox base image: Node 24 LTS + next dev + Caddy + the supervisor, with a MINIMAL
# Next.js starter template and its node_modules PRE-BAKED as a fast base. The open-sandbox build
# agent may `npm install` more dependencies on demand at runtime (the vibe-coding model, R8), and
# the restore path reconciles the snapshotted lockfile — so the baked deps are a SPEED BASE, not a
# frozen set (no longer "no per-session npm install").
#
# Build via `docker buildx build --platform linux/amd64 --push ...` from macOS/Linux (this
# free-trial subscription blocks ACR Tasks / `az acr build`; the Windows VM + `az acr build` path
# is org/prod only — ADR-0015 / D9). The shipped artifact is amd64 whatever the host; a native
# same-arch `docker build` is a dev-loop convenience, and only the in-container smoke tests
# (tests/test_supervisor_guards_incontainer.py) verify the built image. See README.md.
#
# Node 24 = latest active LTS (D11): supersedes the spike's node:20-slim (EOL ~Apr 2026);
# Node 26 does not enter LTS until ~Oct 2026, so hold at 24.
# Debian 12 (bookworm) left regular security support on 12 July 2026 — this is the LIFECYCLE
# move, not a count reduction. Measured like-for-like, trixie carries a slightly larger unfixed
# backlog; the honest reason to take it is that bookworm stops getting fixes at all.
#
# Node and npm are IDENTICAL across the two bases (v24.19.0 / 11.17.0), so this introduces no
# JavaScript-runtime variable. What DOES move is the apt-installed Python below: 3.11 -> 3.13.
# R5 digests (resolved 2026-08-13): index sha256:0711b541c1c33a8a530ac4f0d391baa9a15b3d804695b1b24a47daa5fb60e74d
# linux/amd64 sha256:f2925910482dc53394bc0034c5f4abffcd01de400794c050ca343fe0d733b486
FROM node:24-trixie-slim

# System deps: git (snapshot/restore, Track SANDBOX), python (supervisor), curl (fetch
# Caddy), procps (ps), ca-certificates (TLS to the data-service + npm registry).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates curl python3 python3-pip procps \
    && rm -rf /var/lib/apt/lists/*

# Caddy static binary (build-time egress only; runtime egress is separate). Pinned to v2.11.4 for
# CVE remediation, superseding the spike's v2.8.4 (.mythos/sandbox-spike/results/RESULTS.md) —
# do not revert toward the spike's pin. This is the only genuinely network-facing component in
# the image and it carried every Critical in its bucket: 123 scanner rows against the Go
# toolchain and vendored modules of the 2.8.4 binary.
#
# The version string appears TWICE on the line below — path segment and filename. Both move.
RUN curl -fsSL "https://github.com/caddyserver/caddy/releases/download/v2.11.4/caddy_2.11.4_linux_amd64.tar.gz" \
        | tar -xz -C /usr/local/bin caddy \
    && chmod +x /usr/local/bin/caddy

# Supervisor deps (Debian trixie marks the base env externally-managed → allow the install).
#
# PINNED, not ranged. These are captured from what the previous image actually resolved to on
# build day, so the Python 3.11 -> 3.13 move is the ONLY supervisor-side variable in this
# rebuild — measured identical on both bases before pinning, so it is a capture rather than an
# upgrade. The old `fastapi>=0.111` was wider than it looked: starlette crossed a major under it.
RUN pip3 install --no-cache-dir --break-system-packages \
        "fastapi==0.141.1" "uvicorn[standard]==0.52.2"

# Unprivileged user for `next dev` — the untrusted app process. It CANNOT read root's env,
# so it cannot read the supervisor token (ADR-0014 in-sandbox-RCE closure). C1 demotes
# children to `appuser` by name; THIS image pins its uid at 10001.
RUN useradd -m -u 10001 -s /usr/sbin/nologin appuser

# Baked git identity for the C4 snapshot commits (Track SANDBOX). `git config --system`
# writes world-readable /etc/gitconfig, so `snapshot.sh` — which runs as the demoted `appuser`
# via /exec — commits WITHOUT per-invocation `-c user.name=…` flags, keeping the scripts clean.
# `safe.directory=*` is defensive: git keeps working if /workspace/app is ever re-owned (nothing
# does today — entrypoint.sh no longer chowns at boot — but a bind-mounted workspace would);
# `init.defaultBranch=main` silences the init hint on the idempotent `git init`.
RUN git config --system user.name "BIAL Snapshot Bot" \
    && git config --system user.email "snapshot-bot@bial.local" \
    && git config --system init.defaultBranch main \
    && git config --system safe.directory '*'

# --- supervisor + proxy + entrypoint ------------------------------------------------------
WORKDIR /supervisor
COPY supervisor/app.py /supervisor/app.py
COPY Caddyfile /etc/caddy/Caddyfile
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
# C4 snapshot/restore mechanics (Track SANDBOX). Baked onto PATH so the reference client drives them
# over the frozen /exec (`/usr/local/bin/{snapshot,restore}.sh <workspace> [b64]`).
COPY scripts/snapshot.sh scripts/restore.sh /usr/local/bin/

# ADR-0015 cross-platform guard: strip any CR a Windows checkout introduced, THEN chmod. (A
# `#!/bin/sh\r` shebang would make the container fail at start — CRLF has burned BIAL twice.) The
# guard is extended to cover the incoming scripts/ before they are marked executable.
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh /etc/caddy/Caddyfile \
        /usr/local/bin/snapshot.sh /usr/local/bin/restore.sh \
    && chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/snapshot.sh /usr/local/bin/restore.sh

# --- golden template + baked node_modules -------------------------------------------------
# Copy manifests first for layer caching, install with the pinned lockfile (byte-identical
# installs — D11), then copy the rest of the template. `npm ci` keeps devDependencies
# (typescript / tailwind / types) which `next dev` needs, so DO NOT set NODE_ENV=production here.
#
# The app process AND every runtime `npm install` run as appuser, so appuser must own the
# workspace to write node_modules (on-demand installs), `.next` and the HMR caches — otherwise
# they EACCES (R8/R13). That ownership is established at COPY/install time (`--chown` + an
# appuser `npm ci`) rather than by a trailing `RUN chown -R appuser:appuser /workspace/app`:
# a chown changes only metadata, but a metadata change rewrites all ~20.8k entries into a new
# layer — a file-for-file duplicate of node_modules costing ~196 MB compressed, which also broke
# esbuild's three hardlinks and stored 31 MB twice. Installing AS appuser satisfies the same
# ordering invariant by construction instead of by a fix-up step.
#
# The runtime npm cache is created here too: a deterministic, appuser-owned path so an on-demand
# `npm install` at runtime (run as appuser via /exec) — and the restore reconcile install — never
# falls back to a root-owned one. It stays EMPTY in the image; the build below uses its own.
RUN mkdir -p /workspace/app /home/appuser/.npm \
    && chown appuser:appuser /workspace/app /home/appuser/.npm
WORKDIR /workspace/app
USER appuser
COPY --chown=appuser:appuser template/package.json template/package-lock.json ./
# The BUILD cache is disposable: nothing reads it at runtime (`npm_config_cache` below points at
# /home/appuser/.npm), so ~175 MB of root-owned cache used to ride the image for nothing. It must
# be written AND deleted inside ONE `RUN` — an `rm -rf` in a later layer only shadows the bytes,
# the image still ships them. HOME is pinned so npm resolves its config and logs under appuser
# even where the builder does not derive HOME from /etc/passwd.
RUN HOME=/home/appuser npm ci --cache /tmp/npm-build-cache --no-audit --no-fund --loglevel=error \
    && rm -rf /tmp/npm-build-cache
COPY --chown=appuser:appuser template/ ./
# Back to root for the remainder: entrypoint.sh runs as PID 1 root so the supervisor can demote
# children to appuser (C1). The image's final USER and WORKDIR are unchanged by U7.
USER root

ENV CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true \
    WORKSPACE=/workspace/app \
    APP_USER=appuser \
    NEXT_TELEMETRY_DISABLED=1 \
    npm_config_cache=/home/appuser/.npm

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
