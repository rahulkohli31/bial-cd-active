# Python bytecode + tool caches produced by the Track SANDBOX test harness (mirrors
# backend/.gitignore). The harness runs under the backend uv env; these are never committed.
__pycache__/
*.py[cod]

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Node install for the acceptance-(a) Playwright driver (tests/acceptance_a/) — never committed.
# Anchor the lockfile to that dir so it can never shadow the tracked, build-critical
# template/package-lock.json (Dockerfile.sandbox's `npm ci` depends on it).
node_modules/
/tests/acceptance_a/package-lock.json
