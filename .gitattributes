# Line-ending policy. Shell scripts and Dockerfiles run inside Linux containers,
# so they MUST be LF — a Windows checkout (core.autocrlf=true) would otherwise
# ship CRLF, and a `#!/bin/sh\r` shebang makes the kernel exec `/bin/sh\r`
# -> "exec ...: no such file or directory" at container start.
*.sh        text eol=lf
Dockerfile* text eol=lf

# The portal's nginx template ships into the image and is rendered by envsubst at start. It is
# the one shipped config covered by neither rule above. A stray CR does not break the current
# directives (verified: a fully-CRLF build serves byte-identical headers), but nginx SILENTLY
# DROPS a header whose quoted value carries one across a line break — no error, just a missing
# security header. Matches portal/nginx.conf only; no other .conf exists under portal/.
portal/*.conf text eol=lf

# Binary fixtures must never be line-ending-normalized.
*.pptx      binary

# --- sandbox/ (the golden template + pre-baked base image; built on the Windows VM) ---------
# The image is BUILT+DEPLOYED from a Windows VM (ADR-0015 / D9). A Windows checkout with
# core.autocrlf=true would otherwise ship CRLF into shell scripts / Dockerfile / Caddyfile and
# break the container at start (`#!/bin/sh\r` → "no such file or directory"). Force LF across the
# whole tree; lockfiles are text; images/fonts are binary so they are never normalized.
sandbox/**              text eol=lf
sandbox/**/*.png        binary
sandbox/**/*.jpg        binary
sandbox/**/*.jpeg       binary
sandbox/**/*.gif        binary
sandbox/**/*.webp       binary
sandbox/**/*.ico        binary
sandbox/**/*.woff       binary
sandbox/**/*.woff2      binary
sandbox/**/*.ttf        binary
sandbox/**/*.otf        binary

# --- the platform-owned build assets for published apps -------------------------------------
# These files are COPIED VERBATIM into every generated app's Docker build context, and they
# ship inside the backend image — which is itself built on the Windows VM. A CRLF checkout
# would bake `\r` into the app Dockerfile and the production migrator, breaking the build for
# every citizen at once.
#
# WHAT THIS RULE ACTUALLY ADDS is `next.config.ts`, `copy-runtime-deps.mjs`, `db-migrate.mjs`,
# `dockerignore` and `gitkeep` — nothing above matches any of them. The `Dockerfile` in that
# directory is ALREADY covered: a gitattributes pattern with no `/` matches a basename at ANY
# depth, so `Dockerfile*` at the top of this file reaches
# `backend/src/services/deploy/assets/Dockerfile` on its own. This paragraph used to name that
# file among the things "NOT covered by any rule above", which is the opposite of true and is
# checkable in one command: `git check-attr -a -- backend/src/services/deploy/assets/Dockerfile`
# answers `text: set` / `eol: lf` with this line deleted. The rule stays anyway — it is the one
# that covers the other five, and the overlap on `Dockerfile` is free.
backend/src/services/deploy/assets/**   text eol=lf
